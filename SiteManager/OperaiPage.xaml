<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteManager.OperaiPage">
    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="2" Margin="30,30,30,0">
                <CollectionView x:Name="OperaiCollectionView" SelectionMode="None" SelectionChanged="OnSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <FlexLayout Direction="Row" AlignItems="Start" Wrap="NoWrap">
                                <VerticalStackLayout Margin="5" Padding="5" WidthRequest="-1">
                                    <HorizontalStackLayout>
                                        <Label Text="Nome:" VerticalTextAlignment="Center" />
                                        <Label Text="{Binding Nome}" VerticalTextAlignment="Center" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                        <Label Text="Cognome:" VerticalTextAlignment="Center" />
                                        <Label Text="{Binding Cognome}" VerticalTextAlignment="Center" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                        <Label Text="Mansione:" VerticalTextAlignment="Center" />
                                        <Label Text="{Binding Mansione}" VerticalTextAlignment="Center" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                        <Label Text="{Binding DataNascita}" IsVisible="Hidden"/>
                                        <Label Text="{Binding DataAssunzione}" IsVisible="Hidden"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Margin="20,0,0,0" VerticalOptions="Start" WidthRequest="-1">
                                    <Button Text="Visualizza" Clicked="VisualizzaOperaio_Clicked" FontSize="11" Margin="3"  BackgroundColor="LightGray" TextColor="SteelBlue"/>
                                    <Button Text="Modifica" Clicked="ModificaOperaio_Clicked" CommandParameter="{Binding}" FontSize="11" Margin="3"  BackgroundColor="LightGray" TextColor="SteelBlue"/>
                                    <Button Text="Elimina" Clicked="EliminaOperaio_Clicked" CommandParameter="{Binding}" FontSize="11" Margin="3" BackgroundColor="LightGray" TextColor="SteelBlue"/>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        
        <StackLayout Grid.Row="1" Spacing="10" Margin="30,10,30,0">
            <Button
                Grid.Row="1"
                Text="Aggiungi operaio" 
                Clicked="AggiungiOperaio_Clicked" 
                BackgroundColor="SteelBlue"
                HorizontalOptions="Center"
                Margin="0,0,0,10"/>
            
            <StackLayout x:Name="FormStackLayout" IsVisible="False" Spacing="10">
                <Entry x:Name="NomeEntry" Placeholder="Nome" />
                <Entry x:Name="CognomeEntry" Placeholder="Cognome" />
                <Entry x:Name="MansioneEntry" Placeholder="Mansione" />
                <Label Text="Data di nascita:" />
                <DatePicker x:Name="DataNascitaPicker" />
                <Label Text="Data di assunzione:"/>
                <DatePicker x:Name="DataAssunzionePicker" />
            </StackLayout>
        </StackLayout>

        <StackLayout Grid.Row="2" Spacing="10" Margin="30,10,30,30">
            <Button x:Name="SalvaOperaioBtn" Text="Salva" Clicked="SalvaOperaio_Clicked" IsVisible="False" HeightRequest="50" WidthRequest="150" BackgroundColor="LightGray" TextColor="SteelBlue"/>
            <Button x:Name="AggiornaOperaioBtn" Text="Aggiorna" Clicked="AggiornaOperaio_Clicked" IsVisible="False" HeightRequest="50" WidthRequest="150" BackgroundColor="LightGray" TextColor="SteelBlue"/>
        </StackLayout>
    </Grid>
</ContentPage>