<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteManager.ChiusuraGiornataPage"
             Title="Chiusura Giornata">
    
    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Margin="30,30,30,0">
                <CollectionView x:Name="OperaiCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,auto" Padding="5">
                                <HorizontalStackLayout>
                                    <Label Text="Nome:"/>
                                    <Label Text="{Binding Nome}" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                    <Label Text="Cognome:"/>
                                    <Label Text="{Binding Cognome}" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                    <Label Text="Mansione:"/>
                                    <Label Text="{Binding Mansione}" FontSize="18" Margin="5,0,5,0" FontFamily="Roboto" TextColor="SteelBlue"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1">
                                    <Button Text="Ore lavorate" Clicked="OreLavorate_Clicked"  Margin="3"  BackgroundColor="SteelBlue"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        
        <StackLayout Grid.Row="1" Spacing="10" Margin="30,10,30,0">
            <Button
                x:Name="AggiungiSpesaBtn"
                Text="Aggiungi spesa" 
                IsVisible="True"
                Clicked="AggiungiSpesa_Clicked" 
                BackgroundColor="SteelBlue"
                HorizontalOptions="Center"
                Margin="0,0,0,10"/>
            
            <StackLayout x:Name="FormStackLayout" IsVisible="False" Spacing="10">
                <Entry x:Name="DescrizioneEntry" Placeholder="Descrizione" />
                <Entry x:Name="CostoEntry" Placeholder="Costo" />
            </StackLayout>
        </StackLayout>

        <StackLayout Grid.Row="2" Spacing="10" Margin="30,10,30,30">
            <Button x:Name="SalvaSpesaBtn" Text="Salva" Clicked="SalvaSpesa_Clicked" IsVisible="False" BackgroundColor="SteelBlue" HorizontalOptions="Center"/>
        </StackLayout>
    </Grid>
</ContentPage>